<Window x:Class="FortniteTweakTool.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Fortnite Tweak Tool" Height="820" Width="1260" MinHeight="700" MinWidth="1050"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Left">
     <TextBlock Text="FORTNITE TWEAK TOOL" FontSize="22" FontWeight="Bold"/>
     <TextBlock Text="Performance • Input • Network" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
     <TextBlock x:Name="HeaderStatus" Text="Systemstatus wird geladen…" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Right"/>
     <TextBlock Text="Keine garantierten FPS-/Ping-Steigerungen" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,5,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="10" Margin="0,0,16,0">
   <StackPanel>
    <TextBlock Text="NAVIGATION" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,10,0,12"/>
    <Button Content="▦  Dashboard" Click="Dashboard_Click" HorizontalContentAlignment="Left"/>
    <Button Content="⚡  FPS Boost" Click="Fps_Click" HorizontalContentAlignment="Left"/>
    <Button Content="⌁  Input Delay" Click="Input_Click" HorizontalContentAlignment="Left"/>
    <Button Content="◉  Ping Optimizer" Click="Ping_Click" HorizontalContentAlignment="Left"/>
    <Button Content="↶  Restore Center" Click="Restore_Click" HorizontalContentAlignment="Left"/>
    <Button Content="⚙  Settings &amp; Logs" Click="Settings_Click" HorizontalContentAlignment="Left"/>
    <Border Background="#22243A" CornerRadius="9" Padding="10" Margin="4,24,4,0">
     <TextBlock Text="Sicherheit zuerst&#10;Jede Systemänderung benötigt eine separate UAC-Freigabe. Vor Änderungen wird versucht, einen Wiederherstellungspunkt anzulegen." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
    </Border>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
     <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="26" FontWeight="Bold"/>
     <TextBlock x:Name="PageSubtitle" Text="Echte Systemdaten und nachvollziehbare Aktionen." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
     <Grid x:Name="DashboardPanel">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <UniformGrid Rows="1" Columns="3" Margin="0,0,0,14">
       <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="15" Margin="4">
        <StackPanel><TextBlock Text="SYSTEM" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashWindows" Text="Windows wird geprüft" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
       </Border>
       <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="15" Margin="4">
        <StackPanel><TextBlock Text="PING-TEST" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashPing" Text="Nicht gemessen" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/><Button Content="Ping testen" Click="PingTest_Click" HorizontalAlignment="Left"/></StackPanel>
       </Border>
       <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="15" Margin="4">
        <StackPanel><TextBlock Text="FORTNITE" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashFortnite" Text="Status unbekannt" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/><Button Content="System neu scannen" Click="Refresh_Click" HorizontalAlignment="Left"/></StackPanel>
       </Border>
      </UniformGrid>
      <Grid Grid.Row="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="16" Margin="4">
        <StackPanel><TextBlock Text="SYSTEMANALYSE" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/><TextBox x:Name="SystemReport" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></StackPanel>
       </Border>
       <Border Grid.Column="1" Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="16" Margin="4">
        <StackPanel>
         <TextBlock Text="ONE-CLICK OPTIMIZATION" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
         <TextBlock Text="Aktiviert Windows Game Mode und optional den Hochleistungs-Energieplan. Vorher wird ein Wiederherstellungspunkt versucht. Jede Änderung kann UAC erfordern." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,16"/>
         <CheckBox x:Name="OneClickGameMode" Content="Game Mode aktivieren" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,4"/>
         <CheckBox x:Name="OneClickPower" Content="Hochleistungs-Energieplan aktivieren (mehr Strom/Hitze möglich)" IsChecked="False" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4"/>
         <Button Content="OPTIMIERUNG STARTEN" Background="{StaticResource AccentBrush}" Click="OneClick_Click" Margin="0,16,0,0"/>
         <TextBlock x:Name="ActionStatus" Text="Bereit." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,10,4,0"/>
        </StackPanel>
       </Border>
      </Grid>
     </Grid>
     <ScrollViewer x:Name="ContentPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock x:Name="SectionIntro" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4,0,4,16"/>
       <ItemsControl x:Name="TweaksList">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="14" Margin="4,4,4,8">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
             <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"/>
             <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
             <TextBlock Text="{Binding Risk, StringFormat='Risiko: {0}'}" Foreground="#FFC66D" Margin="0,7,0,0" FontSize="11"/>
             <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" Foreground="{StaticResource BlueBrush}" Margin="0,3,0,0" FontSize="11"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Anwenden" Tag="{Binding Key}" Click="ApplyTweak_Click" VerticalAlignment="Center"/>
           </Grid>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <StackPanel x:Name="RestoreActions" Visibility="Collapsed" Margin="4">
        <TextBlock Text="Wiederherstellung" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Text="Windows-Wiederherstellungspunkte können je nach Systemrichtlinie deaktiviert sein. Die Registry-Backups werden lokal gespeichert." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <WrapPanel>
         <Button Content="Wiederherstellungspunkt erstellen" Click="RestorePoint_Click"/>
         <Button Content="Game Mode rückgängig machen" Click="UndoGameMode_Click"/>
         <Button Content="Backup-Ordner öffnen" Click="OpenBackup_Click"/>
        </WrapPanel>
        <TextBlock x:Name="BackupInfo" TextWrapping="Wrap" Margin="4,12,4,0"/>
       </StackPanel>
       <StackPanel x:Name="SettingsActions" Visibility="Collapsed" Margin="4">
        <TextBlock Text="Einstellungen & Protokolle" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Text="Die App startet standardmäßig nicht automatisch mit Windows. Änderungen werden protokolliert." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <WrapPanel><Button Content="Log anzeigen" Click="ShowLog_Click"/><Button Content="Log-Ordner öffnen" Click="OpenLog_Click"/><Button Content="Log leeren" Click="ClearLog_Click"/></WrapPanel>
        <TextBox x:Name="LogOutput" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="220" Background="#0B0D14" Foreground="{StaticResource TextBrush}" BorderBrush="#343B58" Padding="10"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Border>
  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Fortnite Tweak Tool • Transparente Tweaks statt fragwürdiger Registry-Sammlungen • lokale Logs" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,12,0,0"/>
 </Grid>
</Window>
